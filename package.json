{
  "name": "sales-system",
  "version": "1.0.0",
  "description": "Sales management system",
  "main": "main.js",
  "author": "Sales System",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sales.system",
    "productName": "SalesSystem",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
